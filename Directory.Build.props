<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <Company>SmartDock</Company>
    <Product>SmartDock</Product>
    <!-- Single source of the release version (SemVer). Bump here for every delivered build; see CHANGELOG.md. -->
    <Version>1.25.3</Version>
    <!-- Lets the Windows-only projects restore/build from a non-Windows CI host. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>
</Project>
