<Window x:Class="SmartDock.App.Views.WidgetManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SmartDock Widgets"
        Width="760" Height="620" MinWidth="460" MinHeight="400"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI Variable Text, Segoe UI">
    <DockPanel Margin="24,16,24,20">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="Widgets" FontSize="24" FontWeight="SemiBold" />
            <TextBlock Margin="0,4,0,14" Opacity="0.7" TextWrapping="Wrap"
                       Text="Click Add, or drag a card onto the dock. Changes apply immediately and are saved." />
            <DockPanel Margin="0,0,0,14">
                <ComboBox DockPanel.Dock="Right" Width="160" Margin="10,0,0,0" ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}" />
                <TextBox x:Name="SearchBox" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" ToolTip="Search widgets" />
            </DockPanel>
        </StackPanel>

        <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <Button DockPanel.Dock="Right" Content="Close" Padding="16,5" Click="OnClose" IsCancel="True" />
            <Button Content="Reset dock layout" HorizontalAlignment="Left" Padding="12,5" Click="OnResetLayout" />
        </DockPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding View}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Width="220" Height="168" Margin="0,0,12,12" Padding="14" CornerRadius="10" BorderThickness="1"
                                BorderBrush="#22808080" Background="#0C808080" Cursor="SizeAll"
                                PreviewMouseLeftButtonDown="OnCardMouseDown" PreviewMouseMove="OnCardMouseMove" Tag="{Binding TypeId}">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
                                    <Border Width="34" Height="34" CornerRadius="8" Background="#337C5CFF">
                                        <TextBlock Text="{Binding Glyph}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" />
                                        <TextBlock Text="{Binding Category}" FontSize="11" Opacity="0.6" />
                                    </StackPanel>
                                </StackPanel>
                                <DockPanel DockPanel.Dock="Bottom">
                                    <Button DockPanel.Dock="Right" Content="Add" Padding="12,3" Command="{Binding AddCommand}" Cursor="Hand" />
                                    <Button DockPanel.Dock="Right" Content="Remove" Padding="10,3" Margin="0,0,6,0" Command="{Binding RemoveCommand}" Cursor="Hand" />
                                    <TextBlock Text="{Binding StatusText}" FontSize="11" Opacity="0.7" VerticalAlignment="Center" />
                                </DockPanel>
                                <TextBlock Text="{Binding Description}" TextWrapping="Wrap" FontSize="12" Opacity="0.8" Margin="0,10,0,8" TextTrimming="CharacterEllipsis" />
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</Window>
