<Window x:Class="SmartDock.App.Views.DockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:SmartDock.App.Controls"
        xmlns:core="clr-namespace:SmartDock.Core;assembly=SmartDock.Core"
        Title="SmartDock"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        FontFamily="{DynamicResource UiFont}"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <!-- Application icon button: icon, monogram fallback, running dot / active pill. -->
        <Style x:Key="DockAppButton" TargetType="Button">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="1,0" />
            <Setter Property="AllowDrop" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Width="{DynamicResource WidgetHeight}" Height="{DynamicResource WidgetHeight}" Background="Transparent">
                            <Border x:Name="Hover" CornerRadius="{DynamicResource WidgetCornerRadius}" Background="{DynamicResource WidgetHoverBrush}" Opacity="0" />
                            <ContentPresenter />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.94" ScaleY="0.94" />
                                    </Setter.Value>
                                </Setter>
                                <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RegionDivider" TargetType="Border">
            <Setter Property="Width" Value="1" />
            <Setter Property="Margin" Value="6,9" />
            <Setter Property="Background" Value="{DynamicResource DividerBrush}" />
        </Style>

        <Style x:Key="WidgetRegion" TargetType="ItemsControl">
            <Setter Property="AllowDrop" Value="True" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="MinWidth" Value="24" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <c:WidgetCard Content="{Binding}" />
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="RootGrid" MouseEnter="OnRootMouseEnter" MouseLeave="OnRootMouseLeave">
        <!-- Nearly transparent strip at the screen edge; reveals the dock when auto-hide is on. -->
        <Border x:Name="HotStrip" Height="6" VerticalAlignment="Bottom" Background="#01000000" Visibility="Collapsed" />

        <Grid x:Name="DockHost" Margin="18,12,18,12">
            <Grid.RenderTransform>
                <TranslateTransform x:Name="SlideTransform" />
            </Grid.RenderTransform>

            <!-- MinHeight (not Height): with "second row" wrapping the dock grows taller when it's full. -->
            <Border x:Name="DockBorder"
                    MinHeight="{DynamicResource DockHeight}"
                    CornerRadius="{DynamicResource DockCornerRadius}"
                    Background="{DynamicResource DockBackgroundBrush}"
                    BorderBrush="{DynamicResource DockBorderBrush}"
                    BorderThickness="1"
                    Padding="{DynamicResource DockPadding}"
                    ContextMenuOpening="OnDockContextMenuOpening">
                <Border.ContextMenu>
                    <ContextMenu />
                </Border.ContextMenu>

                <DockPanel x:Name="DockContent" LastChildFill="True" VerticalAlignment="Center">
                  <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Left region: Start + pinned and running applications -->
                    <Button x:Name="StartButton" Style="{StaticResource DockAppButton}" Click="OnStartClick" ToolTip="Start">
                        <Grid Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition />
                                <RowDefinition />
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Grid.Column="0" Margin="0.75" CornerRadius="1.5" Background="{DynamicResource AccentBrush}" />
                            <Border Grid.Row="0" Grid.Column="1" Margin="0.75" CornerRadius="1.5" Background="{DynamicResource AccentBrush}" />
                            <Border Grid.Row="1" Grid.Column="0" Margin="0.75" CornerRadius="1.5" Background="{DynamicResource AccentBrush}" />
                            <Border Grid.Row="1" Grid.Column="1" Margin="0.75" CornerRadius="1.5" Background="{DynamicResource AccentBrush}" />
                        </Grid>
                    </Button>

                    <ItemsControl x:Name="AppsList" ItemsSource="{Binding Apps.Items}" VerticalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource DockAppButton}"
                                        ToolTip="{Binding ToolTip}"
                                        Click="OnAppClick"
                                        MouseEnter="OnAppMouseEnter"
                                        MouseLeave="OnAppMouseLeave"
                                        ContextMenuOpening="OnAppContextMenuOpening"
                                        PreviewMouseLeftButtonDown="OnAppPreviewMouseDown"
                                        PreviewMouseMove="OnAppPreviewMouseMove"
                                        DragOver="OnAppDragOver"
                                        Drop="OnAppDrop">
                                    <Button.ContextMenu>
                                        <ContextMenu />
                                    </Button.ContextMenu>
                                    <Grid>
                                        <Border x:Name="ActiveBg" CornerRadius="{DynamicResource WidgetCornerRadius}" Background="{DynamicResource AccentSoftBrush}" Visibility="Collapsed" />
                                        <Border x:Name="AttentionBg" CornerRadius="{DynamicResource WidgetCornerRadius}" Background="{DynamicResource WarningBrush}" Opacity="0" IsHitTestVisible="False" />
                                        <Image x:Name="AppIcon" Source="{Binding Icon}" Width="{DynamicResource AppIconSize}" Height="{DynamicResource AppIconSize}"
                                               RenderOptions.BitmapScalingMode="HighQuality" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        <Border x:Name="Monogram" Width="{DynamicResource AppIconSize}" Height="{DynamicResource AppIconSize}" CornerRadius="6"
                                                Background="{DynamicResource AccentSoftBrush}" Visibility="Collapsed">
                                            <TextBlock Text="{Binding Monogram}" Style="{StaticResource PrimaryText}" HorizontalAlignment="Center" />
                                        </Border>
                                        <Border x:Name="RunDot" Width="5" Height="3" CornerRadius="1.5" VerticalAlignment="Bottom" Margin="0,0,0,1"
                                                Background="{DynamicResource TextSecondaryBrush}" Visibility="Collapsed" />
                                    </Grid>
                                </Button>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Icon}" Value="{x:Null}">
                                        <Setter TargetName="Monogram" Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                        <Setter TargetName="RunDot" Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding HasMultipleWindows}" Value="True">
                                        <Setter TargetName="RunDot" Property="Width" Value="9" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                        <Setter TargetName="ActiveBg" Property="Visibility" Value="Visible" />
                                        <Setter TargetName="RunDot" Property="Width" Value="14" />
                                        <Setter TargetName="RunDot" Property="Background" Value="{DynamicResource AccentBrush}" />
                                    </DataTrigger>
                                    <!-- Needs attention: blink a few times, then stay highlighted until the app is opened (like the taskbar). -->
                                    <DataTrigger Binding="{Binding NeedsAttention}" Value="True">
                                        <Setter TargetName="AttentionBg" Property="Opacity" Value="0.45" />
                                        <Setter TargetName="RunDot" Property="Visibility" Value="Visible" />
                                        <Setter TargetName="RunDot" Property="Width" Value="14" />
                                        <Setter TargetName="RunDot" Property="Background" Value="{DynamicResource WarningBrush}" />
                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard x:Name="AttentionBlink">
                                                <Storyboard FillBehavior="Stop">
                                                    <DoubleAnimation Storyboard.TargetName="AttentionBg" Storyboard.TargetProperty="Opacity"
                                                                     From="0.1" To="0.75" Duration="0:0:0.45" AutoReverse="True" RepeatBehavior="8x" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.EnterActions>
                                        <DataTrigger.ExitActions>
                                            <RemoveStoryboard BeginStoryboardName="AttentionBlink" />
                                        </DataTrigger.ExitActions>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border Style="{StaticResource RegionDivider}" />
                  </StackPanel>

                  <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Style="{StaticResource RegionDivider}" />

                    <!-- Right region: system widgets, notifications, settings -->
                    <ItemsControl x:Name="RightList" Tag="Right" Style="{StaticResource WidgetRegion}"
                                  ItemsSource="{Binding RightWidgets}" DragOver="OnRegionDragOver" Drop="OnRegionDrop" />

                    <Button x:Name="BellButton" Style="{StaticResource DockIconButton}" Width="32" Height="32" Margin="3,0,0,0"
                            Click="OnBellClick" ToolTip="Notifications">
                        <Grid>
                            <TextBlock Text="&#xEA8F;" FontFamily="{DynamicResource IconFont}" FontSize="14" />
                            <Border x:Name="BellBadge" MinWidth="13" Height="13" CornerRadius="6.5" Background="{DynamicResource AccentBrush}"
                                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-7,-9,0" Padding="3,0" Visibility="Collapsed">
                                <TextBlock Text="{Binding NotificationCount}" FontFamily="{DynamicResource UiFont}" FontSize="8.5" FontWeight="Bold"
                                           Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                    </Button>
                    <!-- Settings gear with the version underneath: takes no extra width and is never trimmed. -->
                    <Button Style="{StaticResource DockIconButton}" Width="Auto" MinWidth="32" Height="Auto" Margin="0,0,2,0"
                            Click="OnSettingsClick" VerticalAlignment="Center">
                        <Button.ToolTip>
                            <TextBlock>
                                <Run Text="Settings · SmartDock" /> <Run Text="{x:Static core:AppInfo.DisplayVersion}" />
                            </TextBlock>
                        </Button.ToolTip>
                        <StackPanel Margin="4,1">
                            <TextBlock Text="&#xE713;" FontFamily="{DynamicResource IconFont}" FontSize="13" HorizontalAlignment="Center"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="{x:Static core:AppInfo.DisplayVersion}" FontFamily="{DynamicResource UiFont}" FontSize="8.5"
                                       Foreground="{DynamicResource TextSecondaryBrush}" Opacity="0.8" HorizontalAlignment="Center"
                                       TextTrimming="None" TextWrapping="NoWrap" Margin="0,1,0,0" />
                        </StackPanel>
                    </Button>
                  </StackPanel>

                  <!-- Center region: smart widgets (fills the space between the groups when full width) -->
                  <ItemsControl x:Name="CenterList" Tag="Center" Style="{StaticResource WidgetRegion}" HorizontalAlignment="Left"
                                ItemsSource="{Binding CenterWidgets}" DragOver="OnRegionDragOver" Drop="OnRegionDrop" />
                </DockPanel>
            </Border>
        </Grid>

        <!-- Transient toast above the dock -->
        <Popup x:Name="ToastPopup" PlacementTarget="{Binding ElementName=DockBorder}" Placement="Top" VerticalOffset="-8"
               AllowsTransparency="True" StaysOpen="True" Focusable="False" PopupAnimation="None">
            <Border x:Name="ToastBorder" Background="{DynamicResource PopupBackgroundBrush}" BorderBrush="{DynamicResource DockBorderBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="14,10" Margin="12" MaxWidth="360" MouseLeftButtonUp="OnToastClick">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.35" Direction="270" />
                </Border.Effect>
                <Border.RenderTransform>
                    <TranslateTransform x:Name="ToastSlide" />
                </Border.RenderTransform>
                <StackPanel Orientation="Horizontal">
                    <Border Width="4" CornerRadius="2" Margin="0,0,10,0" Background="{DynamicResource AccentBrush}" x:Name="ToastAccent" />
                    <StackPanel>
                        <TextBlock x:Name="ToastTitle" Style="{StaticResource PrimaryText}" />
                        <TextBlock x:Name="ToastMessage" Style="{StaticResource SecondaryText}" FontSize="12" TextWrapping="Wrap" TextTrimming="None" Margin="0,2,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Popup>

        <!-- Notification centre -->
        <Popup x:Name="NotificationsPopup" PlacementTarget="{Binding ElementName=BellButton}" Placement="Top" VerticalOffset="-14"
               AllowsTransparency="True" StaysOpen="False" PopupAnimation="Fade">
            <Border Background="{DynamicResource PopupBackgroundBrush}" BorderBrush="{DynamicResource DockBorderBrush}" BorderThickness="1"
                    CornerRadius="12" Padding="12" Margin="12" Width="340">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.35" Direction="270" />
                </Border.Effect>
                <StackPanel>
                    <DockPanel Margin="2,0,0,8">
                        <Button DockPanel.Dock="Right" Style="{StaticResource DockIconButton}" Width="Auto" Padding="8,0" Click="OnClearNotifications" ToolTip="Clear all">
                            <TextBlock Text="Clear all" FontFamily="{DynamicResource UiFont}" FontSize="11.5" Margin="8,0" />
                        </Button>
                        <TextBlock Text="Notifications" Style="{StaticResource PrimaryText}" FontSize="14" />
                    </DockPanel>
                    <TextBlock x:Name="NoNotifications" Text="You're all caught up." Style="{StaticResource SecondaryText}" FontSize="12" Margin="2,4" />
                    <ScrollViewer MaxHeight="360" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Notifications}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource WidgetBackgroundBrush}" CornerRadius="8" Padding="10,8" Margin="0,0,0,6">
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Style="{StaticResource DockIconButton}" Width="22" Height="22" VerticalAlignment="Top"
                                                    Content="&#xE711;" FontSize="10" Tag="{Binding Id}" Click="OnDismissNotification" ToolTip="Dismiss" />
                                            <StackPanel>
                                                <TextBlock Text="{Binding Title}" Style="{StaticResource PrimaryText}" FontSize="12.5" />
                                                <TextBlock Text="{Binding Message}" Style="{StaticResource SecondaryText}" FontSize="11.5" TextWrapping="Wrap" TextTrimming="None" />
                                                <TextBlock Text="{Binding Timestamp, StringFormat={}{0:HH:mm}}" Style="{StaticResource SecondaryText}" FontSize="10" Opacity="0.7" Margin="0,3,0,0" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</Window>
