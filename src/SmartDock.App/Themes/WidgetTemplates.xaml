<!-- One implicit DataTemplate per widget view-model type. WidgetCard supplies the card chrome. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="clr-namespace:SmartDock.App.Controls"
                    xmlns:clock="clr-namespace:SmartDock.Widgets.Clock;assembly=SmartDock.Widgets"
                    xmlns:sys="clr-namespace:SmartDock.Widgets.SystemMonitor;assembly=SmartDock.Widgets"
                    xmlns:net="clr-namespace:SmartDock.Widgets.Network;assembly=SmartDock.Widgets"
                    xmlns:media="clr-namespace:SmartDock.Widgets.Media;assembly=SmartDock.Widgets"
                    xmlns:prod="clr-namespace:SmartDock.Widgets.Productivity;assembly=SmartDock.Widgets"
                    xmlns:cal="clr-namespace:SmartDock.Widgets.Calendar;assembly=SmartDock.Widgets"
                    xmlns:wx="clr-namespace:SmartDock.Widgets.Weather;assembly=SmartDock.Widgets"
                    xmlns:gh="clr-namespace:SmartDock.Widgets.GitHub;assembly=SmartDock.Widgets"
                    xmlns:ai="clr-namespace:SmartDock.Widgets.AIUsage;assembly=SmartDock.Widgets"
                    xmlns:web="clr-namespace:SmartDock.Widgets.Web;assembly=SmartDock.Widgets"
                    xmlns:k8s="clr-namespace:SmartDock.Widgets.Cluster;assembly=SmartDock.Widgets"
                    xmlns:repo="clr-namespace:SmartDock.Widgets.CodeRepo;assembly=SmartDock.Widgets"
                    xmlns:bm="clr-namespace:SmartDock.Widgets.Bookmarks;assembly=SmartDock.Widgets">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Controls.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- Clock -->
    <DataTemplate DataType="{x:Type clock:ClockWidget}">
        <StackPanel VerticalAlignment="Center" MinWidth="48">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock Text="{Binding ZoneLabel}" Style="{StaticResource SecondaryText}" Margin="0,0,5,0"
                           Visibility="{Binding ZoneLabel, Converter={StaticResource NullToCollapsed}}" />
                <TextBlock Text="{Binding TimeText}" Style="{StaticResource PrimaryText}" FontSize="13.5"
                           Typography.NumeralAlignment="Tabular" />
            </StackPanel>
            <TextBlock Text="{Binding DateText}" Style="{StaticResource SecondaryText}" HorizontalAlignment="Right"
                       Visibility="{Binding ShowDate, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>
    </DataTemplate>

    <!-- CPU -->
    <DataTemplate DataType="{x:Type sys:CpuWidget}">
        <StackPanel Orientation="Horizontal" ToolTip="{Binding ProcessorInfo}">
            <TextBlock Style="{StaticResource IconText}" Text="&#xE9D9;" Margin="0,0,8,0"
                       Foreground="{Binding Percent, Converter={StaticResource LoadToBrush}}" />
            <StackPanel VerticalAlignment="Center" MinWidth="32">
                <TextBlock Text="CPU" Style="{StaticResource SecondaryText}" />
                <TextBlock Text="{Binding ValueText}" Style="{StaticResource PrimaryText}" Typography.NumeralAlignment="Tabular" />
            </StackPanel>
            <c:Sparkline Values="{Binding History}" Width="46" Height="22" Margin="8,0,0,0"
                         Stroke="{DynamicResource AccentBrush}"
                         Visibility="{Binding ShowGraph, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>
    </DataTemplate>

    <!-- Memory -->
    <DataTemplate DataType="{x:Type sys:MemoryWidget}">
        <StackPanel Orientation="Horizontal" ToolTip="{Binding DetailText}">
            <TextBlock Style="{StaticResource IconText}" Text="&#xE964;" Margin="0,0,8,0"
                       Foreground="{Binding Percent, Converter={StaticResource LoadToBrush}}" />
            <StackPanel VerticalAlignment="Center" MinWidth="32">
                <TextBlock Text="RAM" Style="{StaticResource SecondaryText}" />
                <TextBlock Text="{Binding ValueText}" Style="{StaticResource PrimaryText}" Typography.NumeralAlignment="Tabular" />
            </StackPanel>
            <c:Meter Value="{Binding Percent}" Width="40" Height="5" Margin="8,0,0,0" VerticalAlignment="Center"
                     Fill="{Binding Percent, Converter={StaticResource LoadToBrush}}"
                     Track="{DynamicResource WidgetHoverBrush}"
                     Visibility="{Binding ShowGraph, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>
    </DataTemplate>

    <!-- Disk -->
    <DataTemplate DataType="{x:Type sys:DiskWidget}">
        <StackPanel Orientation="Horizontal">
            <TextBlock Style="{StaticResource IconText}" Text="&#xEDA2;" Margin="0,0,8,0" />
            <StackPanel VerticalAlignment="Center" MinWidth="40">
                <TextBlock Style="{StaticResource SecondaryText}">
                    <Run Text="{Binding DriveLabel, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding FreeText, Mode=OneWay}" />
                </TextBlock>
                <TextBlock Text="{Binding ValueText}" Style="{StaticResource PrimaryText}" Typography.NumeralAlignment="Tabular" />
            </StackPanel>
            <c:Meter Value="{Binding Percent}" Width="34" Height="5" Margin="8,0,0,0" VerticalAlignment="Center"
                     Fill="{Binding Percent, Converter={StaticResource LoadToBrush}}"
                     Track="{DynamicResource WidgetHoverBrush}"
                     Visibility="{Binding ShowGraph, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>
    </DataTemplate>

    <!-- Network -->
    <DataTemplate DataType="{x:Type net:NetworkWidget}">
        <StackPanel Orientation="Horizontal">
            <TextBlock x:Name="Glyph" Style="{StaticResource IconText}" Text="&#xE839;" Margin="0,0,8,0" />
            <StackPanel VerticalAlignment="Center" MinWidth="62">
                <TextBlock Style="{StaticResource PrimaryText}" FontSize="11" Typography.NumeralAlignment="Tabular">
                    <Run Text="&#x2193; " Foreground="{DynamicResource SuccessBrush}" /><Run Text="{Binding DownText, Mode=OneWay}" />
                </TextBlock>
                <TextBlock x:Name="Up" Style="{StaticResource SecondaryText}" FontSize="11" Typography.NumeralAlignment="Tabular">
                    <Run Text="&#x2191; " /><Run Text="{Binding UpText, Mode=OneWay}" />
                </TextBlock>
            </StackPanel>
            <c:Sparkline Values="{Binding History}" Width="36" Height="20" Margin="6,0,0,0" Stroke="{DynamicResource SuccessBrush}" />
        </StackPanel>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding IsConnected}" Value="False">
                <Setter TargetName="Glyph" Property="Text" Value="&#xF384;" />
                <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource DangerBrush}" />
                <Setter TargetName="Up" Property="Visibility" Value="Collapsed" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- Battery -->
    <DataTemplate DataType="{x:Type sys:BatteryWidget}">
        <StackPanel Orientation="Horizontal" ToolTip="{Binding Detail}">
            <TextBlock x:Name="Level" Style="{StaticResource IconText}" Text="{Binding LevelGlyph}" FontSize="16" />
            <TextBlock x:Name="Bolt" Style="{StaticResource IconText}" Text="&#xE945;" FontSize="10" Margin="1,0,0,0"
                       Foreground="{DynamicResource WarningBrush}" Visibility="Collapsed" />
            <TextBlock Text="{Binding PercentText}" Style="{StaticResource PrimaryText}" Margin="6,0,0,0" Typography.NumeralAlignment="Tabular" />
        </StackPanel>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding IsCharging}" Value="True">
                <Setter TargetName="Bolt" Property="Visibility" Value="Visible" />
                <Setter TargetName="Level" Property="Foreground" Value="{DynamicResource SuccessBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsLow}" Value="True">
                <Setter TargetName="Level" Property="Foreground" Value="{DynamicResource DangerBrush}" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- Music / media session -->
    <DataTemplate DataType="{x:Type media:MediaWidget}">
        <StackPanel Orientation="Horizontal">
            <Border Width="28" Height="28" CornerRadius="6" Background="{DynamicResource AccentSoftBrush}" ClipToBounds="True">
                <Grid>
                    <TextBlock Style="{StaticResource IconText}" Text="&#xE8D6;" FontSize="13" Foreground="{DynamicResource AccentBrush}" />
                    <Image Source="{Binding Thumbnail, Converter={StaticResource BytesToImage}}" Stretch="UniformToFill"
                           RenderOptions.BitmapScalingMode="HighQuality">
                        <Image.Clip>
                            <RectangleGeometry Rect="0,0,28,28" RadiusX="6" RadiusY="6" />
                        </Image.Clip>
                    </Image>
                </Grid>
            </Border>
            <StackPanel VerticalAlignment="Center" Margin="8,0,6,0" MaxWidth="150" MinWidth="70" ToolTip="{Binding SourceApp}">
                <TextBlock Text="{Binding Title}" Style="{StaticResource PrimaryText}" FontSize="12" />
                <TextBlock Text="{Binding Subtitle}" Style="{StaticResource SecondaryText}" />
            </StackPanel>
            <Button Style="{StaticResource DockIconButton}" Command="{Binding PreviousCommand}" Content="&#xE892;" ToolTip="Previous" />
            <Button Style="{StaticResource DockIconButton}" Command="{Binding PlayPauseCommand}" ToolTip="Play / pause">
                <TextBlock x:Name="PlayGlyph" Text="&#xE768;" FontFamily="{DynamicResource IconFont}" FontSize="14" />
            </Button>
            <Button Style="{StaticResource DockIconButton}" Command="{Binding NextCommand}" Content="&#xE893;" ToolTip="Next" />
        </StackPanel>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                <Setter TargetName="PlayGlyph" Property="Text" Value="&#xE769;" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- Pomodoro -->
    <DataTemplate DataType="{x:Type prod:PomodoroWidget}">
        <StackPanel Orientation="Horizontal">
            <TextBlock x:Name="Glyph" Style="{StaticResource IconText}" Text="&#xE916;" Margin="0,0,8,0" />
            <StackPanel VerticalAlignment="Center" MinWidth="44">
                <TextBlock Text="{Binding RemainingText}" Style="{StaticResource PrimaryText}" Typography.NumeralAlignment="Tabular" />
                <c:Meter Value="{Binding Progress, Converter={StaticResource FractionToPercent}}" Height="3" Margin="0,3,0,0"
                         Fill="{DynamicResource AccentBrush}" Track="{DynamicResource WidgetHoverBrush}" />
            </StackPanel>
            <TextBlock Text="{Binding PhaseText}" Style="{StaticResource SecondaryText}" Margin="6,0,4,0" />
            <Button Style="{StaticResource DockIconButton}" Command="{Binding StartPauseCommand}" ToolTip="Start / pause">
                <TextBlock x:Name="RunGlyph" Text="&#xE768;" FontFamily="{DynamicResource IconFont}" FontSize="13" />
            </Button>
            <Button Style="{StaticResource DockIconButton}" Command="{Binding ResetCommand}" Content="&#xE72C;" ToolTip="Reset" />
        </StackPanel>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding IsRunning}" Value="True">
                <Setter TargetName="RunGlyph" Property="Text" Value="&#xE769;" />
                <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource AccentBrush}" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- Calendar -->
    <DataTemplate DataType="{x:Type cal:CalendarWidget}">
        <StackPanel Orientation="Horizontal">
            <TextBlock x:Name="Glyph" Style="{StaticResource IconText}" Text="&#xE787;" Margin="0,0,8,0" />
            <StackPanel VerticalAlignment="Center" MaxWidth="180" MinWidth="70">
                <TextBlock Text="{Binding Headline}" Style="{StaticResource PrimaryText}" FontSize="12" />
                <TextBlock x:Name="Sub" Text="{Binding Subline}" Style="{StaticResource SecondaryText}" />
            </StackPanel>
            <Button Style="{StaticResource DockIconButton}" Command="{Binding JoinNextCommand}" Content="&#xE714;" ToolTip="Join meeting"
                    Margin="6,0,0,0" Visibility="{Binding CanJoinNext, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding IsSoon}" Value="True">
                <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource AccentBrush}" />
                <Setter TargetName="Sub" Property="Foreground" Value="{DynamicResource AccentBrush}" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- Weather -->
    <DataTemplate DataType="{x:Type wx:WeatherWidget}">
        <StackPanel Orientation="Horizontal" ToolTip="{Binding LocationText}">
            <TextBlock Style="{StaticResource IconText}" Text="{Binding Glyph}" FontSize="17" Margin="0,0,8,0" Foreground="{DynamicResource WarningBrush}" />
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding TemperatureText}" Style="{StaticResource PrimaryText}" FontSize="13.5" />
                <TextBlock Text="{Binding ConditionText}" Style="{StaticResource SecondaryText}" MaxWidth="110" />
            </StackPanel>
        </StackPanel>
    </DataTemplate>

    <!-- GitHub -->
    <DataTemplate DataType="{x:Type gh:GitHubWidget}">
        <StackPanel Orientation="Horizontal" ToolTip="Assigned issues · review requests · notifications">
            <TextBlock Style="{StaticResource IconText}" Text="&#xE943;" Margin="0,0,8,0" />
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding Title}" Style="{StaticResource SecondaryText}" />
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource PrimaryText}" FontSize="12">
                        <Run Text="{Binding Issues, Mode=OneWay}" /><Run Text=" issues" Foreground="{DynamicResource TextSecondaryBrush}" FontWeight="Normal" />
                    </TextBlock>
                    <TextBlock Style="{StaticResource PrimaryText}" FontSize="12" Margin="8,0,0,0">
                        <Run Text="{Binding Reviews, Mode=OneWay}" /><Run Text=" reviews" Foreground="{DynamicResource TextSecondaryBrush}" FontWeight="Normal" />
                    </TextBlock>
                    <TextBlock Style="{StaticResource PrimaryText}" FontSize="12" Margin="8,0,0,0"
                               Visibility="{Binding HasNotificationCount, Converter={StaticResource BoolToVisibility}}">
                        <Run Text="{Binding Notifications, Mode=OneWay}" /><Run Text=" &#x2709;" Foreground="{DynamicResource TextSecondaryBrush}" FontWeight="Normal" />
                    </TextBlock>
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </DataTemplate>

    <!-- Claude / OpenAI usage (shared base type) -->
    <DataTemplate DataType="{x:Type ai:AiUsageWidgetBase}">
        <StackPanel Orientation="Horizontal">
            <TextBlock Style="{StaticResource IconText}" Text="&#xE99A;" Margin="0,0,8,0" Foreground="{DynamicResource AccentBrush}" />
            <StackPanel VerticalAlignment="Center" MinWidth="58">
                <TextBlock Text="{Binding ProviderName}" Style="{StaticResource SecondaryText}" />
                <TextBlock Text="{Binding ValueText}" Style="{StaticResource PrimaryText}" Typography.NumeralAlignment="Tabular" ToolTip="{Binding DetailText}" />
            </StackPanel>
            <c:Meter Value="{Binding BudgetPercent}" Width="36" Height="5" Margin="8,0,0,0" VerticalAlignment="Center"
                     Fill="{Binding BudgetPercent, Converter={StaticResource LoadToBrush}}" Track="{DynamicResource WidgetHoverBrush}"
                     Visibility="{Binding HasBudget, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>
    </DataTemplate>

    <!-- Notes -->
    <DataTemplate DataType="{x:Type prod:NotesWidget}">
        <StackPanel Orientation="Horizontal" ToolTip="Click to open notes">
            <TextBlock Style="{StaticResource IconText}" Text="&#xE70B;" Margin="0,0,8,0" />
            <StackPanel VerticalAlignment="Center" MaxWidth="160">
                <TextBlock Style="{StaticResource SecondaryText}">
                    <Run Text="Notes · " /><Run Text="{Binding Count, Mode=OneWay}" />
                </TextBlock>
                <TextBlock Text="{Binding Latest}" Style="{StaticResource PrimaryText}" FontSize="12" />
            </StackPanel>
        </StackPanel>
    </DataTemplate>

    <!-- Everything search -->
    <DataTemplate DataType="{x:Type prod:EverythingWidget}">
        <StackPanel Orientation="Horizontal" ToolTip="Click to search files with Everything">
            <TextBlock Style="{StaticResource IconText}" Text="&#xE721;" Margin="0,0,8,0" />
            <StackPanel VerticalAlignment="Center" MaxWidth="140">
                <TextBlock Text="Everything" Style="{StaticResource SecondaryText}" />
                <TextBlock Text="{Binding StatusText}" Style="{StaticResource PrimaryText}" FontSize="12" />
            </StackPanel>
        </StackPanel>
    </DataTemplate>

    <!-- Web page status -->
    <DataTemplate DataType="{x:Type web:WebStatusWidget}">
        <StackPanel Orientation="Horizontal" ToolTip="Web page status – click for details">
            <TextBlock x:Name="Glyph" Style="{StaticResource IconText}" Text="&#xE774;" Margin="0,0,8,0" Foreground="{DynamicResource TextSecondaryBrush}" />
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Sites" Style="{StaticResource SecondaryText}" />
                <TextBlock Text="{Binding Summary}" Style="{StaticResource PrimaryText}" FontSize="12" />
            </StackPanel>
        </StackPanel>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding Overall}" Value="{x:Static web:SiteHealth.Up}">
                <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource SuccessBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Overall}" Value="{x:Static web:SiteHealth.Slow}">
                <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource WarningBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Overall}" Value="{x:Static web:SiteHealth.Down}">
                <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource DangerBrush}" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- Kubernetes cluster -->
    <DataTemplate DataType="{x:Type k8s:KubernetesWidget}">
        <StackPanel Orientation="Horizontal" ToolTip="{Binding Server}">
            <Grid Margin="0,0,8,0" VerticalAlignment="Center">
                <TextBlock Style="{StaticResource IconText}" Text="&#xE7B8;" />
                <Ellipse x:Name="Dot" Width="7" Height="7" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-3,-1"
                         Fill="{DynamicResource TextSecondaryBrush}" />
            </Grid>
            <StackPanel VerticalAlignment="Center" MaxWidth="170">
                <TextBlock Text="{Binding Title}" Style="{StaticResource SecondaryText}" />
                <TextBlock Text="{Binding Summary}" Style="{StaticResource PrimaryText}" FontSize="12" />
            </StackPanel>
        </StackPanel>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding Health}" Value="{x:Static k8s:ClusterHealth.Healthy}">
                <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource SuccessBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Health}" Value="{x:Static k8s:ClusterHealth.Warning}">
                <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource WarningBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Health}" Value="{x:Static k8s:ClusterHealth.Critical}">
                <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource DangerBrush}" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- Quick folders -->
    <DataTemplate DataType="{x:Type prod:QuickFoldersWidget}">
        <StackPanel Orientation="Horizontal" ToolTip="Saved folders – click to open; drag folders here to add">
            <TextBlock Style="{StaticResource IconText}" Text="&#xE8B7;" Margin="0,0,8,0" />
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Folders" Style="{StaticResource SecondaryText}" />
                <TextBlock Text="{Binding CountText}" Style="{StaticResource PrimaryText}" FontSize="12" />
            </StackPanel>
        </StackPanel>
    </DataTemplate>

    <!-- Script runner -->
    <DataTemplate DataType="{x:Type prod:ScriptRunnerWidget}">
        <StackPanel Orientation="Horizontal" ToolTip="Script runner – click for status and output">
            <TextBlock x:Name="Glyph" Style="{StaticResource IconText}" Text="&#xE756;" Margin="0,0,8,0" />
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Scripts" Style="{StaticResource SecondaryText}" />
                <TextBlock Text="{Binding Summary}" Style="{StaticResource PrimaryText}" FontSize="12" />
            </StackPanel>
        </StackPanel>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding Overall}" Value="{x:Static prod:ScriptState.Running}">
                <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource AccentBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Overall}" Value="{x:Static prod:ScriptState.Succeeded}">
                <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource SuccessBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Overall}" Value="{x:Static prod:ScriptState.Failed}">
                <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource DangerBrush}" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- CodeHub / GitLab -->
    <DataTemplate DataType="{x:Type repo:CodeRepoWidget}">
        <StackPanel Orientation="Horizontal" ToolTip="Merge requests and pipelines – click for details">
            <Grid Margin="0,0,8,0" VerticalAlignment="Center">
                <TextBlock x:Name="Glyph" Style="{StaticResource IconText}" Text="&#xE943;" />
                <Border CornerRadius="6" MinWidth="12" Height="12" Padding="3,0" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-6,-9,0"
                        Background="{DynamicResource AccentBrush}"
                        Visibility="{Binding ReviewCount, Converter={StaticResource ZeroToVisible}, ConverterParameter=invert}">
                    <TextBlock Text="{Binding ReviewCount}" FontFamily="{DynamicResource UiFont}" FontSize="8.5" FontWeight="Bold" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
            </Grid>
            <StackPanel VerticalAlignment="Center" MaxWidth="190">
                <TextBlock Text="{Binding Title}" Style="{StaticResource SecondaryText}" />
                <TextBlock Text="{Binding Summary}" Style="{StaticResource PrimaryText}" FontSize="12" />
            </StackPanel>
        </StackPanel>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding AnyFailing}" Value="True">
                <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource DangerBrush}" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- Bookmarks -->
    <DataTemplate DataType="{x:Type bm:BookmarksWidget}">
        <StackPanel Orientation="Horizontal" ToolTip="Bookmarks – click to browse, right-click › Search">
            <TextBlock Style="{StaticResource IconText}" Text="&#xE728;" Margin="0,0,8,0" Foreground="{DynamicResource AccentBrush}" />
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Bookmarks" Style="{StaticResource SecondaryText}" />
                <TextBlock Text="{Binding Summary}" Style="{StaticResource PrimaryText}" FontSize="12" />
            </StackPanel>
        </StackPanel>
    </DataTemplate>

    <!-- Quick actions -->
    <DataTemplate DataType="{x:Type prod:QuickActionsWidget}">
        <ItemsControl ItemsSource="{Binding Actions}" Margin="-6,0">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button Style="{StaticResource DockIconButton}" Width="30" Height="30" Command="{Binding RunCommand}"
                            Content="{Binding Glyph}" FontSize="14" ToolTip="{Binding Label}" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </DataTemplate>

    <!-- Volume -->
    <DataTemplate DataType="{x:Type prod:VolumeWidget}">
        <StackPanel Orientation="Horizontal" ToolTip="{Binding DeviceName}">
            <TextBlock Style="{StaticResource IconText}" Text="{Binding Glyph}" FontSize="15" />
            <TextBlock Text="{Binding LevelText}" Style="{StaticResource PrimaryText}" Margin="6,0,0,0" Typography.NumeralAlignment="Tabular" />
        </StackPanel>
    </DataTemplate>

    <!-- Clipboard -->
    <DataTemplate DataType="{x:Type prod:ClipboardWidget}">
        <StackPanel Orientation="Horizontal">
            <TextBlock Style="{StaticResource IconText}" Text="&#xE77F;" Margin="0,0,8,0" />
            <TextBlock Text="{Binding CountText}" Style="{StaticResource SecondaryText}" FontSize="11.5" />
        </StackPanel>
    </DataTemplate>
</ResourceDictionary>
